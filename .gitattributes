# Fin de linea por tipo de archivo (el proyecto corre en Windows, Linux y macOS)

* text=auto

# Scripts de shell: deben quedar con LF o bash dice "\r: command not found"
*.sh text eol=lf
*.command text eol=lf

# Scripts de Windows
*.bat text eol=crlf
*.ps1 text eol=crlf

# Codigo de Python
# LF (no CRLF): el shebang "#!/usr/bin/env python3" solo funciona si la
# primera linea termina en LF. Con CRLF, ejecutar ./Respaldos.py en Linux o
# macOS falla con "bad interpreter: /usr/bin/env python3\r".
*.py text eol=lf

# Los .ico son binarios
*.ico binary
*.png binary
*.exe binary
