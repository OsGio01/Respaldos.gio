# Archivos personales y documentos excluidos del repositorio

/ignorados/

# Bytecode de Python (se regenera solo)
/__pycache__/
*.pyc

# Artefactos de PyInstaller
build/
dist/

# Clave de red: nunca se versiona (vive junto al config, con permisos restringidos)
clave_red.key

# Estado y configuracion que generan los scripts minimos de terminal
respaldos.conf
respaldos.estado
respaldos.fuentes.tmp

# Respaldos generados en caliente
Respaldos/

# Datos que el programa escribe en la carpeta de datos del sistema.
# En el repositorio quedan los de ejemplo, pero estos son de la maquina.
/core/config.json
/core/config/
/core/estados/
/core/estados_respaldo.json
/core/respaldos_generados.json
/core/ultimo_respaldo.txt
/core/rutas_respaldo.txt
